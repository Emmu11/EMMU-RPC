<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EmmuRpc</RootNamespace>
    <AssemblyName>EMMU RPC</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <ApplicationIcon>Assets\EMMU-RPC.ico</ApplicationIcon>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\EMMU-RPC-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Launcher\Program.cs" />
    <Compile Include="Launcher\GameNameCatalog.cs" />
    <Compile Include="Launcher\NeonControls.cs" />
    <Compile Include="Launcher\VersionResourceWriter.cs" />
    <Compile Include="Launcher\AssemblyInfo.cs" />
    <EmbeddedResource Include="build\GeneratedApp.exe">
      <LogicalName>EmmuRpc.Resources.GeneratedApp.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\GameNames.txt">
      <LogicalName>EmmuRpc.Resources.GameNames.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

